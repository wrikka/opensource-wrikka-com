{
	"name": "opensource-wrikka-com",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"prebuild": "bun run pull-docs && bun scripts/generate-seo.ts",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"verify": "bun run typecheck && bun run build",
		"deploy": "wrangler deploy",
		"pull-docs": "bun node_modules/@wrikka/create-docs/scripts/github-pull.ts --config create-docs.config.ts"
	},
	"dependencies": {
		"@orpc/client": "^1.15.0",
		"@orpc/server": "^1.15.0",
		"@tanstack/solid-router": "^1.170.30",
		"@wrikka/create-docs": "0.2.4",
		"marked": "^18.0.11",
		"solid-js": "^1.9.15",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@iconify-json/mdi": "^1.2.3",
		"source-map": "^0.8.0",
		"typescript": "^7.0.2",
		"unocss": "^66.10.0",
		"vite": "^8.2.2",
		"vite-plugin-solid": "^2.11.14",
		"wrangler": "4"
	}
}
